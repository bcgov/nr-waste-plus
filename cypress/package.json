{
  "name": "nr-waste-plus-cypress",
  "version": "1.0.0",
  "description": "Cypress end-to-end user journey tests for nr-waste-plus, using Cucumber for BDD-style test scenarios executed during pull requests.",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "report:md": "node scripts/parse-report.js",
    "test:unit": "node --test scripts/*.test.js",
    "report:clean": "rm -rf reports/*",
    "precy:run": "npm run report:clean",
    "cy:run": "cypress run --browser chrome",
    "postcy:run": "npm run report:md",
    "precy:run:local": "npm run report:clean",
    "cy:run:local": "cypress run  --browser chrome --config \"baseUrl=http://localhost:3000\"",
    "postcy:run:local": "npm run report:md",
    "precy:run:md:local": "npm run report:clean",
    "cy:run:md:local": "cypress run  --browser chrome --config \"baseUrl=http://localhost:3000\"",
    "postcy:run:md:local": "npm run report:md",
    "cy:open:local": "cypress open --config \"baseUrl=https://nr-waste-plus-40-frontend.apps.silver.devops.gov.bc.ca/\""
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "cypress",
    "cucumber",
    "e2e",
    "user-journey",
    "bdd",
    "testing",
    "accessibility",
    "lighthouse"
  ],
  "author": "Team Alliance",
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@cypress/webpack-preprocessor": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/cypress": "^10.1.0",
    "@types/node": "^26.0.0",
    "axe-core": "^4.11.0",
    "cypress": "^16.0.0",
    "cypress-real-events": "^1.14.0",
    "dotenv": "^18.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lighthouse": "^13.0.0",
    "mochawesome": "^8.0.0",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.81.0"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "fast-uri": "4.2.3",
    "glob": "^14.0.4"
  },
  "allowScripts": {
    "cypress@16.0.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
