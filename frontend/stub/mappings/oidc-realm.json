{
  "mappings": [
    {
      "name": "OIDC discovery for the mock standard realm",
      "request": {
        "urlPath": "/realms/standard/.well-known/openid-configuration",
        "method": "GET"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "issuer": "http://localhost:8181/realms/standard",
          "authorization_endpoint": "http://localhost:8181/realms/standard/protocol/openid-connect/auth",
          "token_endpoint": "http://localhost:8181/realms/standard/protocol/openid-connect/token",
          "userinfo_endpoint": "http://localhost:8181/realms/standard/protocol/openid-connect/userinfo",
          "end_session_endpoint": "http://localhost:8181/realms/standard/protocol/openid-connect/logout",
          "jwks_uri": "http://localhost:8181/realms/standard/protocol/openid-connect/certs",
          "response_types_supported": ["code"],
          "grant_types_supported": ["authorization_code", "refresh_token"],
          "subject_types_supported": ["public"],
          "id_token_signing_alg_values_supported": ["RS256"],
          "code_challenge_methods_supported": ["S256"],
          "scopes_supported": ["openid", "profile", "email"]
        }
      }
    },
    {
      "name": "OIDC JWKS for the mock standard realm",
      "request": {
        "urlPath": "/realms/standard/protocol/openid-connect/certs",
        "method": "GET"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "bodyFileName": "oidc/jwks.json"
      }
    },
    {
      "name": "OIDC authorize (fresh scenario)",
      "scenarioName": "mock-oidc-code-flow",
      "requiredScenarioState": "Started",
      "newScenarioState": "CODE_ISSUED",
      "request": {
        "urlPath": "/realms/standard/protocol/openid-connect/auth",
        "method": "GET"
      },
      "response": {
        "status": 302,
        "transformers": ["response-template"],
        "headers": {
          "Location": "{{request.query.redirect_uri}}?code=mock-{{request.query.kc_idp_hint}}-{{randomValue length=12 type='ALPHANUMERIC'}}&state={{request.query.state}}"
        }
      }
    },
    {
      "name": "OIDC authorize (code already issued)",
      "scenarioName": "mock-oidc-code-flow",
      "requiredScenarioState": "CODE_ISSUED",
      "newScenarioState": "CODE_ISSUED",
      "request": {
        "urlPath": "/realms/standard/protocol/openid-connect/auth",
        "method": "GET"
      },
      "response": {
        "status": 302,
        "transformers": ["response-template"],
        "headers": {
          "Location": "{{request.query.redirect_uri}}?code=mock-{{request.query.kc_idp_hint}}-{{randomValue length=12 type='ALPHANUMERIC'}}&state={{request.query.state}}"
        }
      }
    },
    {
      "name": "OIDC authorize (code already used — re-issues)",
      "scenarioName": "mock-oidc-code-flow",
      "requiredScenarioState": "CODE_USED",
      "newScenarioState": "CODE_ISSUED",
      "request": {
        "urlPath": "/realms/standard/protocol/openid-connect/auth",
        "method": "GET"
      },
      "response": {
        "status": 302,
        "transformers": ["response-template"],
        "headers": {
          "Location": "{{request.query.redirect_uri}}?code=mock-{{request.query.kc_idp_hint}}-{{randomValue length=12 type='ALPHANUMERIC'}}&state={{request.query.state}}"
        }
      }
    },
    {
      "name": "OIDC token exchange — IDIR user",
      "scenarioName": "mock-oidc-code-flow",
      "requiredScenarioState": "CODE_ISSUED",
      "newScenarioState": "CODE_USED",
      "request": {
        "urlPath": "/realms/standard/protocol/openid-connect/token",
        "method": "POST",
        "bodyPatterns": [{ "contains": "code=mock-azureidir-" }]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "bodyFileName": "oidc/token-idir.json"
      }
    },
    {
      "name": "OIDC token exchange — BCeID user",
      "scenarioName": "mock-oidc-code-flow",
      "requiredScenarioState": "CODE_ISSUED",
      "newScenarioState": "CODE_USED",
      "request": {
        "urlPath": "/realms/standard/protocol/openid-connect/token",
        "method": "POST",
        "bodyPatterns": [{ "contains": "code=mock-bceidbusiness-" }]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "bodyFileName": "oidc/token-bceid.json"
      }
    },
    {
      "name": "OIDC token exchange — authorization code already used",
      "scenarioName": "mock-oidc-code-flow",
      "requiredScenarioState": "CODE_USED",
      "request": {
        "urlPath": "/realms/standard/protocol/openid-connect/token",
        "method": "POST"
      },
      "response": {
        "status": 400,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "invalid_grant", "error_description": "Code already exchanged" }
      }
    },
    {
      "name": "OIDC token exchange — no authorize preceded",
      "scenarioName": "mock-oidc-code-flow",
      "requiredScenarioState": "Started",
      "request": {
        "urlPath": "/realms/standard/protocol/openid-connect/token",
        "method": "POST"
      },
      "response": {
        "status": 400,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "invalid_grant", "error_description": "No authorization code issued" }
      }
    },
    {
      "name": "OIDC end-session",
      "request": {
        "urlPath": "/realms/standard/protocol/openid-connect/logout",
        "method": "GET"
      },
      "response": {
        "status": 302,
        "transformers": ["response-template"],
        "headers": {
          "Location": "{{request.query.post_logout_redirect_uri}}"
        }
      }
    }
  ]
}
