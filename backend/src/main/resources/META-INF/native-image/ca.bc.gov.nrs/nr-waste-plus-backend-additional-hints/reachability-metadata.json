{
  "resources": [
    {
      "glob": "db/testdata"
    },
    {
      "glob": "db/testdata/**"
    }
  ],
  "reflection": [
    {
      "type": "org.springframework.security.config.annotation.web.builders.HttpSecurity",
      "methods": [
        {
          "name": "headers",
          "parameterTypes": [
            "org.springframework.security.config.Customizer"
          ]
        },
        {
          "name": "csrf",
          "parameterTypes": [
            "org.springframework.security.config.Customizer"
          ]
        },
        {
          "name": "cors",
          "parameterTypes": [
            "org.springframework.security.config.Customizer"
          ]
        },
        {
          "name": "authorizeHttpRequests",
          "parameterTypes": [
            "org.springframework.security.config.Customizer"
          ]
        },
        {
          "name": "oauth2ResourceServer",
          "parameterTypes": [
            "org.springframework.security.config.Customizer"
          ]
        }
      ]
    },
    {
      "type": "ca.bc.gov.nrs.hrs.entity.block.ReportingUnitIdGenerator",
      "allDeclaredConstructors": true,
      "allPublicConstructors": true,
      "allDeclaredMethods": true,
      "allPublicMethods": true
    }
  ]
}
