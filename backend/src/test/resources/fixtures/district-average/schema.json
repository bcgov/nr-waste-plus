{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "District Average Parity Fixture",
  "description": "Golden-case parity fixture for #1214, independently recomputed from the Provincial v1.1 workbook and Waste Manual pages 37-38 and 52-54. Verifies HALF_UP 3dp rounding and highest-volume residual allocation without exposing executable formulas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "area",
    "benchmarkZone",
    "workbookReference",
    "inputs",
    "expected"
  ],
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$",
      "description": "kebab/UPPER e.g. INTERIOR-DRY-BELT-01"
    },
    "area": {
      "type": "string",
      "enum": ["INTERIOR", "COASTAL"]
    },
    "benchmarkZone": {
      "type": "string",
      "description": "Interior: Dry belt|Transition zone|Wet belt or Coast synthetic; must match InteriorZoneDto/CoastSectionDto comments"
    },
    "maturity": {
      "type": "string",
      "enum": ["Immature", "Mature"],
      "description": "Coast-only maturity section"
    },
    "workbookReference": {
      "type": "string",
      "minLength": 15,
      "pattern": "^(?=.*(Provincial v1\\.1 workbook|Coast Table Layout))(?=.*Manual p(37|38|52|53|54)(-\\d+)?).+$",
      "description": "Minimal human-readable citation naming the workbook and relevant manual page/table."
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "districtCode",
        "netWasteAreaHa",
        "tableLevelFactor",
        "has_dispersed_retention",
        "heli_logging",
        "species",
        "benchmark"
      ],
      "properties": {
        "districtCode": { "type": "string", "pattern": "^D[A-Z]{2}$" },
        "netWasteAreaHa": { "type": "number", "exclusiveMinimum": 0 },
        "tableLevelFactor": { "type": "number", "exclusiveMinimum": 0 },
        "has_dispersed_retention": { "type": "boolean" },
        "dispersedRetentionPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "heli_logging": { "type": "boolean" },
        "heli_multiplier": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "species": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "grade", "volumeM3"],
            "properties": {
              "code": { "type": "string", "minLength": 2 },
              "grade": { "type": "string" },
              "volumeM3": { "type": "number", "minimum": 0 }
            }
          }
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone", "valueM3PerHa", "source"],
          "properties": {
            "zone": { "type": "string", "minLength": 1 },
            "valueM3PerHa": { "type": "number", "exclusiveMinimum": 0 },
            "source": {
              "type": "string",
              "pattern": "^(?=.*Manual p(37|38|52|53|54)(-\\d+)?).+$"
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unroundedTotalM3", "roundedTotalM3", "residualAllocation"],
      "properties": {
        "unroundedTotalM3": { "type": "number" },
        "roundedTotalM3": { "type": "number" },
        "residualAllocation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["species", "grade", "residualM3"],
            "properties": {
              "species": { "type": "string" },
              "grade": { "type": "string" },
              "residualM3": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["area"],
        "properties": { "area": { "const": "COASTAL" } }
      },
      "then": { "required": ["maturity"] }
    },
    {
      "if": {
        "properties": {
          "inputs": {
            "required": ["has_dispersed_retention"],
            "properties": { "has_dispersed_retention": { "const": true } }
          }
        }
      },
      "then": {
        "properties": {
          "inputs": { "required": ["dispersedRetentionPct"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inputs": {
            "required": ["heli_logging"],
            "properties": { "heli_logging": { "const": true } }
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "required": ["heli_multiplier"],
            "properties": {
              "heli_multiplier": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  ]
}
